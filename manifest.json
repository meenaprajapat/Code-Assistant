{
    "manifest_version": 3,
    "name": "CodeBuddy",
    "version": "1.0.0",
    "description": "Uses AI to analyze LeetCode problems and provide guided hints, pseudo-code, and solutions.",
    "permissions": [
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "https://leetcode.com/problems/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://leetcode.com/problems/*"
            ],
            "js": [
                "content_script.js"
            ],
            "css": [
                "styles.css"
            ]
        }
    ],
    "action": 
    {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/logo5.png",
            "48": "icons/logo5.png",
            "128": "icons/logo5.png"
        }
    },
    "icons": {
        "16": "icons/logo5.png",
        "48": "icons/logo5.png",
        "128": "icons/logo5.png"
    }
    ,
    "web_accessible_resources": [
        {
            "resources": [
                "panel.html"
            ],
            "matches": [
                "https://leetcode.com/*"
            ]
        }
    ]
}